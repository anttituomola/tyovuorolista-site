---
import Contact from '../components/mainPage/Contact.astro'
import ContactForm from '../components/mainPage/ContactForm.astro'
import AboutPage from '../components/pages/AboutPage.astro'
import Layout from '../layouts/Layout.astro'
import { getLocaleFromAstro, getTranslationObject } from '../utils/translations'

const locale = getLocaleFromAstro(Astro)
const contactFormTranslations = getTranslationObject('contactForm', locale)
const contactPage = getTranslationObject('pages.contact', locale)
---

<Layout
    title={contactPage?.title}
    description="Ota yhteyttä tyovuorolista.fi:n tekijään: sähköposti, yhteydenottolomake ja tuki työvuorolistan käyttöön."
>
    <main class="contact-page">
        <Contact
          locale={locale}
          contactPage={contactPage}
          directContact={contactFormTranslations}
        />
        <AboutPage locale={locale} showHero={false} showCta={false} />
        <ContactForm locale={locale} translations={contactFormTranslations} />
    </main>
</Layout>

<style>
    .contact-page {
        padding-bottom: var(--space-xl);
    }
</style>
