---
// The hero video's poster is the LCP element. Preload the one the viewport
// will actually show — keep the breakpoint in sync with Hero.astro.
---

<link
	rel="preload"
	as="image"
	href="/videos/hero-4x5-poster.webp"
	type="image/webp"
	media="(max-width: 768px)"
	fetchpriority="high"
/>
<link
	rel="preload"
	as="image"
	href="/videos/hero-16x9-poster.webp"
	type="image/webp"
	media="(min-width: 769px)"
	fetchpriority="high"
/>
