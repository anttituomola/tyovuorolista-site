---
import Button from '../common/Button.astro'
import { getImage } from 'astro:assets'
import tyovuorolista_hero from '../../assets/tyovuorolista_hero.png'
import { t } from '../../utils/translations'

const { locale = 'fi' } = Astro.props

// Keep in sync with HeroLcpPreload.astro
const heroImage = await getImage({
    src: tyovuorolista_hero,
    width: 600,
    format: 'webp',
})
---

<div class="hero">
    <h1>{t('hero.title', locale as 'fi' | 'en' | 'sv')}</h1>
    <p class="tagline">{t('hero.tagline', locale as 'fi' | 'en' | 'sv')}</p>
    <div class="heroImage">
        <img
            src={heroImage.src}
            alt="Työvuorolista"
            width={heroImage.attributes.width}
            height={heroImage.attributes.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />
    </div>
    <h2 class="subtitle">{t('hero.subtitle', locale as 'fi' | 'en' | 'sv')}</h2>
    <span class="buttons">
        <Button variant="primary" locale={locale} />
        <span style="color: var(--harmaa);">{t('hero.or', locale as 'fi' | 'en' | 'sv')}</span>
        <Button variant="secondary" text={t('hero.tryDemo', locale as 'fi' | 'en' | 'sv')} href="https://app.tyovuorolista.fi/demo" target="_blank" />
    </span>
</div>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-wrap: balance;
        padding: var(--space-xl) var(--space-base);
        gap: var(--space-lg);
    }
    .heroImage {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        overflow: hidden;
        margin: var(--space-base) 0;
    }
    h1 {
        font-size: var(--text-5xl);
        font-weight: 600;
        margin-bottom: 0;
        max-width: 90%;
    }
    .tagline {
        font-size: var(--text-base);
        color: var(--harmaa);
        font-weight: 400;
        max-width: 90%;
        margin: 0;
        line-height: 1.5;
    }
    .subtitle {
        font-size: var(--text-2xl);
        font-weight: 500;
        max-width: 85%;
        margin: 0;
        color: var(--tummanvihrea);
    }
    .buttons {
        display: flex;
        align-items: center;
        gap: var(--space-base);
        flex-wrap: wrap;
        justify-content: center;
    }
    .buttons span {
        font-size: var(--text-sm);
        font-weight: 500;
    }
    @media (max-width: 768px) {
        .hero {
            gap: var(--space-base);
            padding: var(--space-lg) var(--space-base);
        }
        h1 {
            font-size: var(--text-4xl);
            max-width: 95%;
        }
        .subtitle {
            font-size: var(--text-xl);
            max-width: 90%;
        }
        .heroImage img {
            width: 90%;
            height: auto;
        }
        .buttons {
            flex-direction: column;
            gap: var(--space-sm);
        }
    }
</style>
