---
import Button from '../common/Button.astro'
import { t } from '../../utils/translations'

const { locale = 'fi' } = Astro.props
---

<div class="wrapper">
    <h2>{t('demoVideo.title', locale as 'fi' | 'en' | 'sv')}</h2>
    <p class="description">
        {t('demoVideo.description', locale as 'fi' | 'en' | 'sv')}
    </p>
    <div class="videoContainer">
        <!-- Poster is a sized WebP; video src is attached only when near viewport so it doesn't compete with LCP. -->
        <video
            class="lazy-autoplay-video"
            controls
            muted
            loop
            playsinline
            preload="none"
            width="100%"
            poster="/blogPostImages/tyovuorolista_hero-poster.webp"
            data-src="/blogPostImages/tyovuorolista-demo.webm"
        >
            Your browser doesn't support video.
        </video>
    </div>
    <div class="stepByStep">
        <div class="step">
            <span class="numberedBox">1</span><Button variant="primary" text={t('demoVideo.step1', locale as 'fi' | 'en' | 'sv')} href="https://app.tyovuorolista.fi/register" />
        </div>
        <div class="step">
            <span class="numberedBox">2</span><span class="stepText">{t('demoVideo.step2', locale as 'fi' | 'en' | 'sv')}</span>
        </div>
        <div class="step">
            <span class="numberedBox">3</span><span class="stepText">{t('demoVideo.step3', locale as 'fi' | 'en' | 'sv')}</span>
        </div>
    </div>
</div>

<script>
    const videos = document.querySelectorAll('video.lazy-autoplay-video[data-src]')
    if (videos.length > 0) {
        const loadVideo = (video) => {
            const src = video.dataset.src
            if (!src || video.querySelector('source')) return
            const source = document.createElement('source')
            source.src = src
            source.type = 'video/webm'
            video.appendChild(source)
            video.load()
            void video.play().catch(() => {})
        }

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (!entry.isIntersecting) continue
                        loadVideo(entry.target)
                        observer.unobserve(entry.target)
                    }
                },
                { rootMargin: '200px 0px' }
            )
            videos.forEach((video) => observer.observe(video))
        } else {
            videos.forEach(loadVideo)
        }
    }
</script>

<style>
    h2 {
        font-size: var(--text-3xl);
        text-align: center;
        margin-bottom: var(--space-base);
        font-weight: 500;
    }
    .description {
        font-size: var(--text-lg);
        text-align: center;
        max-width: 600px;
        margin: 0 auto var(--space-2xl) auto;
        line-height: 1.6;
    }
    .videoContainer {
        margin: var(--space-2xl) auto;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
        max-width: 800px;
    }
    .videoContainer video {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        background: #000;
    }
    .step {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        padding: var(--space-base);
    }
    .stepText {
        font-size: var(--text-base);
        font-weight: 500;
        color: var(--tummanvihrea);
    }
    .numberedBox {
        border: 1px solid var(--ruskeaharmaa);
        border-radius: 50%;
        width: 1.75rem;
        height: 1.75rem;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 600;
        font-size: var(--text-sm);
        background: white;
        color: var(--tummanvihrea);
        flex-shrink: 0;
    }
    .stepByStep {
        display: flex;
        justify-content: center;
        gap: var(--space-xl);
        margin-top: var(--space-2xl);
        flex-wrap: wrap;
    }
    @media (max-width: 768px) {
        h2 {
            font-size: var(--text-2xl);
        }
        .description {
            font-size: var(--text-base);
            max-width: 90%;
        }
        .stepByStep {
            flex-direction: column;
            gap: var(--space-base);
            align-items: center;
        }
        .step {
            justify-content: flex-start;
            width: 100%;
            max-width: 300px;
        }
    }
</style>
