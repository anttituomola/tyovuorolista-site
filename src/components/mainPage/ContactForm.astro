---
const { locale = 'fi', translations = {} } = Astro.props

const title = translations.title ?? 'Haluan kysyä lisää!'
const description =
	translations.description ??
	'Soita tai lähetä WhatsApp-viesti, vastaan nopeasti.'
const emailPlaceholder = translations.emailPlaceholder ?? 'Sähköpostiosoitteesi'
const phonePlaceholder = translations.phonePlaceholder ?? 'Puhelinnumerosi'
const submitLabel = translations.submit ?? 'Lähetä'
const successMessage = translations.success ?? ''
const errorMessage = translations.error ?? ''
const errorNetworkMessage = translations.errorNetwork ?? ''
const errorTurnstileMessage = translations.errorTurnstile ?? ''
const errorValidationMessage =
	translations.errorValidation ?? 'Tarkista syöttämäsi tiedot.'
const callLabel = translations.callAntti ?? 'Soita'
const whatsappLabel = translations.whatsappAntti ?? 'Lähetä WhatsApp-viesti'
const whatsappPrefill =
	translations.whatsappPrefill ??
	'Hei Antti! Haluaisin kuulla lisää Työvuorolistasta.'
const emailMeLabel = translations.emailMe ?? 'Sähköposti'
const callMeLabel = translations.callMe ?? 'Soitto'
const callbackHint =
	translations.callbackHint ?? 'Tai jätä yhteystietosi, niin otan yhteyttä:'
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''

const ANTTI_PHONE_TEL = '+358456798818'
const ANTTI_WHATSAPP_NUMBER = '358456798818'
const whatsappUrl = `https://wa.me/${ANTTI_WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappPrefill)}`
---

<section class="contact-form" data-contact-form lang={locale}>
  <div class="contact-form__panel">
    <div data-contact-form-panel>
      <h2 class="contact-form__title">{title}</h2>
      <p class="contact-form__description">{description}</p>

      <div class="contact-form__primary">
        <a class="contact-form__primary-btn" href={`tel:${ANTTI_PHONE_TEL}`}>
          {callLabel}
        </a>
        <a
          class="contact-form__primary-btn"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {whatsappLabel}
        </a>
      </div>

      <div class="contact-form__callback" data-contact-callback>
        <p class="contact-form__callback-hint">{callbackHint}</p>
        <div class="contact-form__mode-toggle" role="group">
          <button
            type="button"
            class="contact-form__mode-btn"
            data-contact-mode="email"
            aria-pressed="false"
          >
            {emailMeLabel}
          </button>
          <button
            type="button"
            class="contact-form__mode-btn"
            data-contact-mode="phone"
            aria-pressed="false"
          >
            {callMeLabel}
          </button>
        </div>

        <form class="contact-form__fields" data-contact-form-fields hidden novalidate>
          <label class="contact-form__field">
            <span class="visually-hidden" data-contact-input-label>
              {emailPlaceholder}
            </span>
            <input
              type="email"
              name="contact"
              data-contact-input
              autocomplete="email"
              placeholder={emailPlaceholder}
              required
            />
          </label>
          <div class="contact-form__turnstile" data-contact-turnstile></div>
          <button type="submit" class="contact-form__submit" data-contact-submit>
            {submitLabel}
          </button>
        </form>
      </div>
    </div>
    <div class="contact-form__success" data-contact-form-success hidden>
      <h2 class="contact-form__title">{successMessage}</h2>
    </div>
  </div>
</section>

<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer
></script>

<script
  define:vars={{
    errorMessage,
    errorNetworkMessage,
    errorTurnstileMessage,
    errorValidationMessage,
    emailPlaceholder,
    phonePlaceholder,
    turnstileSiteKey,
  }}
>
  const isValidEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)

  const isValidPhone = (value) => {
    const digits = value.replace(/\D/g, '')
    return digits.length >= 6 && digits.length <= 15
  }

  const loadTurnstile = () =>
    new Promise((resolve, reject) => {
      if (window.turnstile) {
        resolve(window.turnstile)
        return
      }

      const started = Date.now()
      const poll = () => {
        if (window.turnstile) {
          resolve(window.turnstile)
          return
        }
        if (Date.now() - started > 10000) {
          reject(new Error('Turnstile failed to load'))
          return
        }
        requestAnimationFrame(poll)
      }
      poll()
    })

  const initContactForms = async () => {
    const forms = document.querySelectorAll('[data-contact-form]')
    if (forms.length === 0) {
      return
    }

    let turnstile
    try {
      turnstile = await loadTurnstile()
    } catch {
      console.error('Cloudflare Turnstile failed to load')
    }

    forms.forEach((root) => {
      if (root.getAttribute('data-contact-initialized') === 'true') {
        return
      }
      root.setAttribute('data-contact-initialized', 'true')

      const panel = root.querySelector('[data-contact-form-panel]')
      const success = root.querySelector('[data-contact-form-success]')
      const form = root.querySelector('[data-contact-form-fields]')
      const submitBtn = root.querySelector('[data-contact-submit]')
      const input = root.querySelector('[data-contact-input]')
      const inputLabel = root.querySelector('[data-contact-input-label]')
      const turnstileContainer = root.querySelector('[data-contact-turnstile]')
      const modeButtons = root.querySelectorAll('[data-contact-mode]')

      if (!panel || !success || !form || !submitBtn || !input || !inputLabel) {
        return
      }

      let mode = null
      let widgetId = null

      if (turnstile && turnstileSiteKey && turnstileContainer) {
        widgetId = turnstile.render(turnstileContainer, {
          sitekey: turnstileSiteKey,
          appearance: 'interaction-only',
          theme: 'light',
        })
      }

      const resetTurnstile = () => {
        if (turnstile && widgetId !== null) {
          turnstile.reset(widgetId)
        }
      }

      const setMode = (nextMode) => {
        mode = nextMode
        form.hidden = false
        input.value = ''

        modeButtons.forEach((btn) => {
          const active = btn.getAttribute('data-contact-mode') === nextMode
          btn.setAttribute('aria-pressed', active ? 'true' : 'false')
          btn.classList.toggle('contact-form__mode-btn--active', active)
        })

        if (nextMode === 'email') {
          input.type = 'email'
          input.name = 'email'
          input.autocomplete = 'email'
          input.placeholder = emailPlaceholder
          inputLabel.textContent = emailPlaceholder
          input.inputMode = 'email'
        } else {
          input.type = 'tel'
          input.name = 'phone'
          input.autocomplete = 'tel'
          input.placeholder = phonePlaceholder
          inputLabel.textContent = phonePlaceholder
          input.inputMode = 'tel'
        }

        input.focus()
      }

      modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const nextMode = btn.getAttribute('data-contact-mode')
          if (nextMode === 'email' || nextMode === 'phone') {
            setMode(nextMode)
          }
        })
      })

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (!mode) {
          return
        }

        const value = input.value.trim()
        const valid =
          mode === 'email' ? isValidEmail(value) : isValidPhone(value)

        if (!valid) {
          alert(errorValidationMessage)
          input.focus()
          return
        }

        const turnstileToken =
          turnstile && widgetId !== null ? turnstile.getResponse(widgetId) : ''

        if (!turnstileToken) {
          alert(errorTurnstileMessage || errorMessage)
          resetTurnstile()
          return
        }

        submitBtn.disabled = true

        try {
          const isDev =
            window.location.hostname === 'localhost' ||
            window.location.hostname === '127.0.0.1'
          const apiUrl = isDev
            ? '/api/handleForm'
            : 'https://www.tyovuorolista.fi/api/handleForm'

          const payload =
            mode === 'email'
              ? { email: value, phone: '', turnstileToken }
              : { email: '', phone: value, turnstileToken }

          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          })

          if (!response.ok) {
            alert(
              response.status === 403
                ? errorTurnstileMessage || errorMessage
                : errorMessage
            )
            resetTurnstile()
            return
          }

          const jsonResponse = await response.json()

          if (jsonResponse.status === 'success') {
            panel.hidden = true
            success.hidden = false
          } else {
            alert(errorMessage)
            resetTurnstile()
          }
        } catch {
          alert(errorNetworkMessage)
          resetTurnstile()
        } finally {
          submitBtn.disabled = false
        }
      })
    })
  }

  initContactForms()
  document.addEventListener('astro:page-load', initContactForms)
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: var(--space-2xl) auto 0;
    width: 100%;
    max-width: 600px;
    padding: var(--space-xl) var(--space-lg);
    box-sizing: border-box;
    text-align: center;
  }

  .contact-form__panel {
    width: 100%;
    background-color: var(--hiekka);
    border-radius: 8px;
    padding: var(--space-2xl) var(--space-xl);
    box-sizing: border-box;
  }

  .contact-form__title {
    margin: 0 0 var(--space-base);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--tummanvihrea);
    line-height: 1.2;
  }

  .contact-form__description {
    margin: 0 auto var(--space-xl);
    max-width: 400px;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--tummanvihrea);
    line-height: 1.5;
  }

  .contact-form__primary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .contact-form__primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 400px;
    padding: 1rem 1.5rem;
    border-radius: 2px;
    border: none;
    background-color: var(--tummanvihrea);
    color: #fff;
    font-size: var(--text-base);
    font-family: inherit;
    font-weight: 600;
    text-decoration: none;
    box-sizing: border-box;
  }

  .contact-form__primary-btn:hover {
    background-color: var(--harmaa);
    color: #fff;
  }

  .contact-form__callback {
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--ruskeaharmaa);
  }

  .contact-form__callback-hint {
    margin: 0 0 var(--space-base);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--tummanvihrea);
  }

  .contact-form__mode-toggle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .contact-form__mode-btn {
    padding: 0.65rem 1.1rem;
    border-radius: 2px;
    border: 1px solid var(--ruskeaharmaa);
    background-color: transparent;
    color: var(--tummanvihrea);
    font-size: var(--text-base);
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-form__mode-btn:hover {
    border-color: var(--tummanvihrea);
  }

  .contact-form__mode-btn--active,
  .contact-form__mode-btn[aria-pressed='true'] {
    border-color: var(--tummanvihrea);
    background-color: var(--tummanvihrea);
    color: #fff;
  }

  .contact-form__fields {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    margin-top: 1rem;
  }

  .contact-form__fields[hidden] {
    display: none !important;
  }

  .contact-form__field {
    width: 100%;
    max-width: 400px;
  }

  .contact-form__field input {
    width: 100%;
    padding: 1rem;
    border-radius: 2px;
    border: 1px solid var(--ruskeaharmaa);
    background-color: #f6f6f6;
    color: var(--tummanvihrea);
    font-size: var(--text-base);
    font-family: inherit;
    box-sizing: border-box;
  }

  .contact-form__field input:focus {
    outline: none;
    background-color: #fff;
    border-color: var(--tummanvihrea);
  }

  .contact-form__turnstile {
    display: flex;
    justify-content: center;
    min-height: 0;
  }

  .contact-form__submit {
    padding: 1rem 1.5rem;
    min-width: 150px;
    border-radius: 2px;
    border: none;
    color: white;
    background-color: var(--tummanvihrea);
    font-size: var(--text-base);
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-form__submit:hover:not(:disabled) {
    background-color: var(--harmaa);
  }

  .contact-form__submit:disabled {
    background-color: var(--harmaa);
    cursor: wait;
  }

  .contact-form__success[hidden],
  [data-contact-form-panel][hidden] {
    display: none !important;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .contact-form__title {
      font-size: var(--text-2xl);
    }
  }
</style>
