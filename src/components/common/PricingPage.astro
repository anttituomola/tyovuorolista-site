---
import Button from './Button.astro'
import { getTranslationObject } from '../../utils/translations'

type PricingFeature = string | { text: string; included?: boolean }

function getFeatureText(feature: PricingFeature) {
    return typeof feature === 'string' ? feature : feature.text
}

function isFeatureIncluded(feature: PricingFeature) {
    return typeof feature === 'string' || feature.included !== false
}

const { locale = 'fi' } = Astro.props
const pricing = getTranslationObject('pages.pricing', locale as 'fi' | 'en' | 'sv')
const tiers = [
    pricing?.tiers?.tier1,
    pricing?.tiers?.tier2,
    pricing?.tiers?.tier3,
    pricing?.tiers?.tier4
].filter(Boolean)
---

<div class="wrapper pricingWrapper" id="pricingRoot" data-billing="yearly">
    <section class="hero">
        <h1>{pricing?.title}</h1>
        <p class="subtitle">{pricing?.subtitle}</p>
        <p class="noticeRow">
            <span>{pricing?.priceNote}</span>
            <span class="noticeDivider" aria-hidden="true"></span>
            <span>{pricing?.taxNote}</span>
        </p>
        <div class="billingToggle" role="tablist" aria-label={pricing?.toggleLabel}>
            <button
                type="button"
                class="billingToggleButton"
                data-billing-target="monthly"
                data-active="false"
            >
                {pricing?.monthlyLabel}
            </button>
            <button
                type="button"
                class="billingToggleButton"
                data-billing-target="yearly"
                data-active="true"
            >
                {pricing?.yearlyLabel}
            </button>
        </div>
        <p class="modeMessage monthlyOnly">{pricing?.monthlyMessage}</p>
    </section>

    <div class="pricing">
        {tiers.map((tier: any) => (
            <section class="pricingElement">
                <div class="cardHeader">
                    <span class="planBadge">{tier?.limit}</span>
                    <h2>{tier?.title}</h2>
                </div>

                <div class="priceBlock">
                    <p class="priceRow monthlyOnly">
                        <span class="price">{tier?.monthlyPrice}</span>
                        <span class="period">{pricing?.monthlyPeriod}</span>
                        <span class="priceSep" aria-hidden="true">·</span>
                        <span class="pricingUnit">{tier?.pricingUnit}</span>
                    </p>
                    <p class="priceRow yearlyOnly">
                        <span class="price">{tier?.yearlyPrice}</span>
                        <span class="period">{pricing?.yearlyPeriod}</span>
                        <span class="priceSep" aria-hidden="true">·</span>
                        <span class="pricingUnit">{tier?.pricingUnit}</span>
                    </p>
                    <div class="savingsBlock">
                        {tier?.yearlySavings && (
                            <>
                                <span class="savingsBadge yearlyOnly">{pricing?.yearlyBadge}</span>
                                <p class="savingsText">{tier?.yearlySavings}</p>
                            </>
                        )}
                    </div>
                </div>

                <ul class="featureList">
                    <li class="featurePrimary">{tier?.limit}</li>
                    {tier?.features?.map((feature: PricingFeature) => {
                        const text = getFeatureText(feature)
                        const included = isFeatureIncluded(feature)

                        return included ? (
                            <li>{text}</li>
                        ) : (
                            <li class="featureExcluded">
                                <span class="visually-hidden">{pricing?.featureUnavailable}: </span>
                                <s>{text}</s>
                            </li>
                        )
                    })}
                </ul>

                <div class="cardAction">
                    <Button variant="primary" locale={locale} />
                </div>
            </section>
        ))}
    </div>
</div>

<script is:inline>
    const pricingRoot = document.getElementById('pricingRoot')

    if (pricingRoot) {
        const toggleButtons = pricingRoot.querySelectorAll('[data-billing-target]')

        const setBilling = billingMode => {
            pricingRoot.dataset.billing = billingMode

            toggleButtons.forEach(button => {
                button.setAttribute(
                    'data-active',
                    String(button.dataset.billingTarget === billingMode)
                )
            })
        }

        toggleButtons.forEach(button => {
            button.addEventListener('click', () => {
                setBilling(button.dataset.billingTarget || 'yearly')
            })
        })

        setBilling(pricingRoot.dataset.billing || 'yearly')
    }
</script>

<style>
    .pricingWrapper {
        padding: 0 var(--space-lg) var(--space-4xl);
    }

    .hero {
        max-width: 760px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-base);
    }

    .subtitle {
        max-width: 680px;
        font-size: var(--text-lg);
    }

    .noticeRow {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.65rem 0.9rem;
        margin: 0;
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--harmaa);
    }

    .noticeDivider {
        display: none;
        width: 1px;
        height: 1em;
        background: rgba(74, 93, 88, 0.28);
    }

    @media (min-width: 641px) {
        .noticeDivider {
            display: block;
        }
    }

    .billingToggle {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem;
        background: white;
        border: 1px solid rgba(74, 93, 88, 0.16);
        border-radius: 999px;
    }

    .billingToggleButton {
        appearance: none;
        border: none;
        background: transparent;
        color: var(--harmaa);
        padding: 0.75rem 1rem;
        border-radius: 999px;
        font: inherit;
        font-size: var(--text-sm);
        font-weight: 600;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .billingToggleButton[data-active='true'] {
        background: var(--tummanvihrea);
        color: white;
    }

    .billingToggleButton:hover {
        transform: translateY(-1px);
    }

    .modeMessage {
        max-width: 720px;
        margin: 0;
        font-size: var(--text-base);
        font-weight: 500;
        color: var(--tummanvihrea);
    }

    #pricingRoot[data-billing='monthly'] .yearlyOnly,
    #pricingRoot[data-billing='yearly'] .monthlyOnly {
        display: none;
    }

    .pricing {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: 1.25rem;
        row-gap: 1.25rem;
        max-width: 1320px;
        width: 100%;
        margin: 2.5rem 0 1.5rem;
    }

    .pricingElement {
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 4;
        row-gap: 0;
        border: 1px solid rgba(74, 93, 88, 0.16);
        border-radius: 1rem;
        padding: 1.15rem 1.25rem 1.25rem;
        background: white;
        box-shadow: 0 10px 30px rgba(45, 58, 53, 0.06);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
        min-width: 0;
    }

    .pricingElement:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 38px rgba(45, 58, 53, 0.1);
        border-color: rgba(172, 173, 148, 0.9);
    }

    .cardHeader {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
        margin-bottom: 0.5rem;
    }

    .cardHeader h2 {
        font-size: var(--text-xl);
        font-weight: 600;
        line-height: 1.2;
        margin: 0;
    }

    .planBadge {
        display: inline-flex;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: rgba(45, 58, 53, 0.07);
        color: var(--tummanvihrea);
        font-size: var(--text-xs);
        font-weight: 600;
    }

    .priceBlock {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
        padding-bottom: 0.85rem;
        margin-bottom: 0.85rem;
        border-bottom: 1px solid rgba(74, 93, 88, 0.12);
    }

    .priceRow {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        column-gap: 0.4rem;
        row-gap: 0.1rem;
        margin: 0;
    }

    .price {
        font-size: clamp(1.5rem, 2.4vw, 1.85rem);
        font-weight: 700;
        line-height: 1.1;
        color: var(--tummanvihrea);
        margin: 0;
    }

    .period,
    .priceSep,
    .pricingUnit {
        font-size: var(--text-sm);
        color: var(--harmaa);
        margin: 0;
    }

    .pricingUnit {
        font-weight: 600;
        color: var(--tummanvihrea);
    }

    .savingsBlock {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
        margin-top: 0.35rem;
    }

    .savingsBadge {
        display: inline-flex;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: rgba(45, 122, 72, 0.12);
        color: #1f6a3c;
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.01em;
        text-transform: uppercase;
    }

    .savingsText {
        font-size: var(--text-xs);
        color: var(--tummanvihrea);
        margin: 0;
        line-height: 1.35;
    }

    .featureList {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .featurePrimary {
        font-weight: 600;
        color: var(--tummanvihrea);
    }

    .featureList li {
        position: relative;
        padding-left: 1.5rem;
        color: var(--harmaa);
        line-height: 1.5;
    }

    .featureList li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.45rem;
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
        background: var(--tummanvihrea);
    }

    .featureList li.featureExcluded {
        color: rgba(74, 93, 88, 0.45);
    }

    .featureList li.featureExcluded s {
        text-decoration: line-through;
        text-decoration-color: rgba(74, 93, 88, 0.35);
    }

    .featureList li.featureExcluded::before {
        background: transparent;
        border: 1.5px solid rgba(74, 93, 88, 0.28);
        box-sizing: border-box;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .cardAction {
        display: flex;
        justify-content: center;
        margin-top: var(--space-xl);
        padding-top: var(--space-lg);
        border-top: 1px solid rgba(74, 93, 88, 0.12);
    }

    @media (max-width: 1100px) {
        .pricing {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .pricingWrapper {
            padding: 0 var(--space-base) var(--space-3xl);
        }

        .pricing {
            grid-template-columns: 1fr;
            margin: 2rem 0 1rem;
        }

        .pricingElement {
            padding: 1.25rem;
        }

        .noticeRow {
            flex-direction: column;
            width: 100%;
            gap: 0.35rem;
        }

        .billingToggle {
            width: 100%;
            box-sizing: border-box;
            justify-content: stretch;
        }

        .billingToggleButton {
            flex: 1 1 0;
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
    }
</style>
