---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Testimonial {
	quote: string
	author: string
	company: string
	image: ImageMetadata
}

interface Props {
	testimonials: Testimonial[]
	previousLabel?: string
	nextLabel?: string
}

const {
	testimonials,
	previousLabel = 'Edellinen',
	nextLabel = 'Seuraava'
} = Astro.props
---

<div class="testimonial-carousel" data-testimonial-carousel>
	<button class="scroll-button scroll-left" type="button" aria-label={previousLabel}>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	</button>
	<button class="scroll-button scroll-right" type="button" aria-label={nextLabel}>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	</button>
	<div class="scroll-indicator">
		<div class="scroll-dots">
			{testimonials.map((_, index) => (
				<span class={`dot${index === 0 ? ' active' : ''}`}></span>
			))}
		</div>
	</div>
	<div class="testimonials-scroll">
		{testimonials.map(testimonial => (
			<div class="testimonial-card">
				<div class="testimonial-image">
					<Image src={testimonial.image} width={160} alt={testimonial.author} loading="lazy" />
				</div>
				<div class="testimonial-content">
					<blockquote>"{testimonial.quote}"</blockquote>
					<cite>
						<strong>{testimonial.author}</strong><br>
						{testimonial.company}
					</cite>
				</div>
			</div>
		))}
	</div>
</div>

<script>
	function initTestimonialCarousels() {
		document.querySelectorAll('[data-testimonial-carousel]').forEach(root => {
			if (!(root instanceof HTMLElement)) return
			if (root.dataset.ready === 'true') return
			root.dataset.ready = 'true'

			const scrollContainer = root.querySelector('.testimonials-scroll')
			const leftButton = root.querySelector('.scroll-left')
			const rightButton = root.querySelector('.scroll-right')
			const dots = root.querySelectorAll('.dot')
			const card = root.querySelector('.testimonial-card')

			if (!(scrollContainer instanceof HTMLElement)) return

			const cardWidth = () => {
				if (!(card instanceof HTMLElement)) return 370
				const gap = parseFloat(getComputedStyle(scrollContainer).columnGap) || 0
				return card.getBoundingClientRect().width + gap
			}

			leftButton?.addEventListener('click', () => {
				scrollContainer.scrollBy({ left: -cardWidth(), behavior: 'smooth' })
			})
			rightButton?.addEventListener('click', () => {
				scrollContainer.scrollBy({ left: cardWidth(), behavior: 'smooth' })
			})

			dots.forEach((dot, index) => {
				dot.addEventListener('click', () => {
					scrollContainer.scrollTo({
						left: index * cardWidth(),
						behavior: 'smooth'
					})
				})
			})

			const updateUI = () => {
				const { scrollLeft, scrollWidth, clientWidth } = scrollContainer
				if (leftButton instanceof HTMLButtonElement) {
					leftButton.disabled = scrollLeft <= 0
				}
				if (rightButton instanceof HTMLButtonElement) {
					rightButton.disabled = scrollLeft >= scrollWidth - clientWidth - 10
				}
				const cardIndex = Math.round(scrollLeft / cardWidth())
				dots.forEach((dot, index) => {
					dot.classList.toggle('active', index === cardIndex)
				})
			}

			scrollContainer.addEventListener('scroll', updateUI)
			updateUI()
		})
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initTestimonialCarousels)
	} else {
		initTestimonialCarousels()
	}
</script>

<style>
	.testimonial-carousel {
		position: relative;
		width: 100%;
		margin: 0 auto;
		overflow-x: clip;
	}

	.scroll-button {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 10;
		background: white;
		border: 1px solid var(--vaaleanharmaa);
		border-radius: 50%;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
		transition: all 0.2s ease;
		color: var(--tummanvihrea);
	}

	.scroll-button:hover {
		background: var(--vaaleanharmaa);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
		transform: translateY(-50%) scale(1.05);
	}

	.scroll-button:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.scroll-left {
		left: 0.5rem;
	}

	.scroll-right {
		right: 0.5rem;
	}

	.testimonials-scroll {
		display: flex;
		gap: var(--space-xl);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		padding: var(--space-base) 0 var(--space-2xl);
		scrollbar-width: thin;
		scrollbar-color: var(--hiekka) transparent;
	}

	.testimonial-card {
		display: flex;
		flex-direction: column;
		background: white;
		border-radius: 12px;
		padding: var(--space-xl) 4.5rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		border: 1px solid var(--vaaleanharmaa);
		flex: 0 0 100%;
		min-width: 100%;
		box-sizing: border-box;
		scroll-snap-align: start;
		gap: var(--space-lg);
	}

	.testimonial-image {
		display: flex;
		justify-content: center;
	}

	.testimonial-image img {
		width: 80px;
		height: 80px;
		object-fit: cover;
		border-radius: 50%;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	.testimonial-content {
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: var(--space-base);
		flex-grow: 1;
	}

	blockquote {
		font-size: var(--text-lg);
		line-height: 1.5;
		color: var(--tummanvihrea);
		font-weight: 500;
		margin: 0;
		font-style: italic;
	}

	cite {
		font-style: normal;
		margin-top: auto;
		padding-top: var(--space-base);
		border-top: 1px solid var(--vaaleanharmaa);
	}

	cite strong {
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--tummanvihrea);
		display: block;
		margin-bottom: var(--space-xs);
	}

	.scroll-indicator {
		display: none;
		justify-content: center;
		margin-bottom: var(--space-lg);
	}

	.scroll-dots {
		display: flex;
		gap: var(--space-sm);
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--vaaleanharmaa);
		cursor: pointer;
	}

	.dot.active {
		background: var(--hiekka);
		transform: scale(1.3);
	}

	@media (max-width: 768px) {
		.scroll-button {
			display: none;
		}

		.testimonial-card {
			padding: var(--space-lg);
		}

		blockquote {
			font-size: var(--text-base);
		}

		.scroll-indicator {
			display: flex;
		}
	}
</style>
