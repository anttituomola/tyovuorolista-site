---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import dayjs from 'dayjs'

const { title, pubDate, image, description, tags } = Astro.props.post.frontmatter
const { url } = Astro.props.post
const { url: imageUrl, alt } = image || { url: '', alt: '' };
const HeadingTag = Astro.props.headingLevel || 'h3'

// Optimized card thumbnails, keyed by the public path used in frontmatter.
// Copies live under src/assets/blogPostImages (public originals stay for the
// markdown pages, which reference them by URL string).
const optimizedImages: Record<string, ImageMetadata> = {}
const imageModules = import.meta.glob('../../assets/blogPostImages/**/*.{png,jpg,jpeg,webp}', {
    eager: true,
    import: 'default',
}) as Record<string, ImageMetadata>
for (const [assetPath, metadata] of Object.entries(imageModules)) {
    optimizedImages[assetPath.replace(/^\.\.\/\.\.\/assets/, '')] = metadata
}
const optimizedImage = imageUrl ? optimizedImages[imageUrl] : undefined
---

<div class="blogPostCard" >
    <a href={url}>
        <div>
            {optimizedImage ? (
                <Image
                    src={optimizedImage}
                    alt={alt}
                    widths={[400, 800]}
                    sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 373px"
                    loading="lazy"
                />
            ) : imageUrl && (
                <img src={imageUrl} alt={alt} loading="lazy" />
            )}
            <HeadingTag class="cardTitle">{title}</HeadingTag>
            <p>{description}</p>
            <p class="metadata">
                Julkaistu {dayjs(pubDate).format('DD.MM.YYYY')}
            </p>
            <p class="tags">
                Avainsanat: {tags.map((tag: string, index: number) => {
                    if (index === tags.length - 1) {
                        return tag
                    } else {
                        return tag + ', '
                    }
                })}
            </p>
        </div>
    </a>
</div>

<style>
img {
    width: 100%;
    height: 120px;
    margin-bottom: var(--space-base);
    object-fit: cover;
    border-radius: 8px;
}
    .blogPostCard {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--vaaleanharmaa);
        padding: var(--space-xl);
        border-radius: 12px;
        background-color: white;
        color: var(--tummanvihrea);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.2s ease;
        height: 100%;
        width: 100%;
        box-sizing: border-box;
    }
    .blogPostCard > a {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }
    .blogPostCard > a > div {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .blogPostCard:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.12);
    }
    .blogPostCard a {
        text-decoration: none;
        color: inherit;
    }
    .cardTitle {
        font-size: var(--text-xl);
        margin: 0 0 var(--space-base) 0;
        font-weight: 600;
        color: var(--tummanvihrea);
        text-align: center;
        line-height: 1.3;
    }
    p {
        font-size: var(--text-sm);
        line-height: 1.5;
        margin: var(--space-xs) 0;
        color: var(--harmaa);
        text-align: center;
    }
    p strong {
        color: var(--tummanvihrea);
        font-weight: 600;
    }
    .metadata {
        font-size: 0.8rem;
        color: var(--harmaa);
        margin-top: 0.5rem;
        text-align: center;
        line-height: 1.4;
    }
    .tags {
        font-size: 0.8rem;
        color: var(--harmaa);
        margin-top: auto;
        padding-top: var(--space-base);
        text-align: center;
        line-height: 1.4;
    }
    @media (max-width: 640px) {
        .blogPostCard {
            width: 100%;
        }
        img {
            width: 100%;
            height: 140px;
            object-fit: cover;
        }
        .cardTitle {
            font-size: var(--text-lg);
        }
        p {
            font-size: var(--text-xs);
        }
        .metadata {
            font-size: 0.8rem;
        }
    }
</style>
