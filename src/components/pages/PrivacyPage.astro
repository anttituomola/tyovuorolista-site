---
import { getPrivacyContent, type PrivacyLocale } from '../../utils/privacyContent.ts'

const { locale = 'en' } = Astro.props
const page = getPrivacyContent(locale as PrivacyLocale)
---

<div class="privacy-container">
    <h1>{page.title}</h1>
    <p class="privacy-intro">{page.intro}</p>

    {page.sections.map((section) => (
        <section class="privacy-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </section>
    ))}
</div>

<style>
    .privacy-container {
        max-width: 800px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem;
        box-sizing: border-box;
    }

    h1 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: var(--tummanvihrea);
        font-size: 2rem;
    }

    .privacy-intro {
        line-height: 1.6;
        margin: 0 0 2rem;
    }

    .privacy-section {
        margin-bottom: 2.5rem;
    }

    .privacy-section h2 {
        color: var(--tummanvihrea);
        border-bottom: 2px solid var(--hiekka);
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
    }

    .privacy-section p {
        line-height: 1.6;
        margin: 0 0 1rem;
    }

    @media (max-width: 768px) {
        .privacy-container {
            padding: 1.5rem;
        }

        h1 {
            font-size: 1.6rem;
        }
    }
</style>
