---
import Layout from '../layouts/Layout.astro'
import Button from '../components/common/Button.astro'
import OmaPortalEntry from '../components/common/OmaPortalEntry.astro'
import dayjs from 'dayjs'
import { isPublishedPubDate } from '../utils/blogPosts'
import { getMarkdownForPath, markdownResponse } from '../utils/siteMarkdown.ts'

const { frontmatter } = Astro.props

if (!isPublishedPubDate(frontmatter.pubDate)) {
    return Astro.rewrite('/404')
}

if (Astro.locals.prefersMarkdown) {
    const raw = getMarkdownForPath(Astro.url.pathname)
    if (raw) {
        return markdownResponse(raw)
    }
}

const siteUrl = (Astro.site || 'https://www.tyovuorolista.fi').toString().replace(/\/$/, '')
const canonicalUrl = `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}`
const publishedIso = dayjs(frontmatter.pubDate).toISOString()
// reviewedDate = latest substantive review; prefer it over an explicit
// modifiedDate, which in turn beats the original pubDate
const dateModifiedSource = frontmatter.reviewedDate || frontmatter.modifiedDate
const dateModifiedIso = dateModifiedSource
    ? dayjs(dateModifiedSource).toISOString()
    : publishedIso

// Optional per-article CTA: posts can point the closing button at the
// feature page that matches their topic instead of the generic register link
const ctaText = frontmatter.ctaText ?? 'Kokeile Työvuorolistaa ilmaiseksi'
const ctaHref = frontmatter.ctaHref ?? 'https://app.tyovuorolista.fi/register'
const imageLayout = frontmatter.image?.layout
const isPhoneHero = imageLayout === 'phone'
const isNarrowHero = imageLayout === 'phone' || imageLayout === 'narrow'

const blogPostingJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: publishedIso,
    dateModified: dateModifiedIso,
    author: {
        '@type': 'Person',
        name: frontmatter.author
    },
    publisher: {
        '@type': 'Organization',
        name: 'True Solutions Oy',
        url: siteUrl
    },
    image: frontmatter.image ? new URL(frontmatter.image.url, siteUrl).href : undefined,
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
    }
}

const breadcrumbJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Etusivu',
            item: `${siteUrl}/`
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Blogitekstit',
            item: `${siteUrl}/blogitekstit`
        },
        {
            '@type': 'ListItem',
            position: 3,
            name: frontmatter.title,
            item: canonicalUrl
        }
    ]
}
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    ogImage={frontmatter.image ? new URL(frontmatter.image.url, siteUrl).href : undefined}
>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <div class="blogWrapper">
        {frontmatter.image && isNarrowHero ? (
            <header class="blogHero blogHero--phone">
                <div class="blogHeroCopy">
                    <h1>{frontmatter.title}</h1>
                    <p class="metadata">Kirjoittanut {frontmatter.author}<br />
                    Julkaistu {dayjs(frontmatter.pubDate).format('DD.MM.YYYY')}</p>
                </div>
                {isPhoneHero ? (
                    <div class="blogHeroMedia tyov-featureDetail__heroMedia--phone">
                        <div class="tyov-screenshotFrame">
                            <img
                                src={frontmatter.image.url}
                                alt={frontmatter.image.alt}
                                width="390"
                                height="844"
                            />
                        </div>
                    </div>
                ) : (
                    <div class="blogHeroMedia">
                        <img
                            class="blogPhone"
                            src={frontmatter.image.url}
                            alt={frontmatter.image.alt}
                        />
                    </div>
                )}
            </header>
        ) : (
            <>
                {frontmatter.image && <img src={frontmatter.image.url} alt={frontmatter.image.alt} />}
                <h1>{frontmatter.title}</h1>
                <p class="metadata">Kirjoittanut {frontmatter.author}<br />
                Julkaistu {dayjs(frontmatter.pubDate).format('DD.MM.YYYY')}</p>
            </>
        )}
        {frontmatter.infoBasis && (
            <aside class="infoBasis">
                <p class="infoBasisText">{frontmatter.infoBasis}</p>
                {frontmatter.reviewedDate && (
                    <p class="infoBasisReviewed">Tarkistettu {dayjs(frontmatter.reviewedDate).format('DD.MM.YYYY')}</p>
                )}
            </aside>
        )}
        {frontmatter.showOmaPortalEntry && <OmaPortalEntry variant="card" />}
        <slot />
        <nav class="postHubLinks" aria-label="Aiheeseen liittyvät sivut">
            <a href="/ominaisuudet">Kaikki ominaisuudet</a>
            <span aria-hidden="true">·</span>
            <a href="/resurssit">Resurssit ja mallipohjat</a>
        </nav>
        <div style="margin: 4rem auto 2rem auto">
            <Button
                text={ctaText}
                variant="primary"
                href={ctaHref}
            />
        </div>
    </div>
</Layout>

<style>
    /* Layout.astro uses flex on .blogWrapper; flex items ignore float,
       so phone screenshots cannot sit beside the following copy. */
    .blogWrapper {
        display: block;
    }

    .blogWrapper::after {
        content: '';
        display: table;
        clear: both;
    }

    .blogHero--phone {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
        gap: 1.5rem 2rem;
        align-items: center;
        margin: var(--space-xl) 0 2rem;
    }

    .blogHero--phone .metadata {
        margin-bottom: 0;
    }

    .blogWrapper .blogHero :global(img) {
        margin: 0;
        padding: 0;
        border: none;
        border-radius: 0;
        box-shadow: none;
    }

    .blogHeroMedia {
        justify-self: center;
        width: 100%;
    }

    .blogWrapper :global(.tyov-portalEntry) {
        margin-top: 0.5rem;
    }

    .blogWrapper :global(.tyov-portalEntry img) {
        margin-top: 0;
    }

    .blogWrapper :global(.tyov-portalEntry__title) {
        margin-top: 0;
        clear: none;
    }

    .blogWrapper :global(h2) {
        margin-top: 4rem;
        clear: both;
    }
    
    .blogWrapper :global(h2:first-of-type) {
        margin-top: 2rem;
    }
    
    .blogWrapper :global(h3) {
        margin-top: 2.5rem;
        clear: both;
    }
    
    .blogWrapper :global(h4) {
        margin-top: 2rem;
        clear: both;
    }
    
    .metadata {
        font-size: 0.9rem;
        color: var(--harmaa);
        margin-top: 0.5rem;
        margin-bottom: 2rem;
    }

    .infoBasis {
        border: 1px solid var(--vaaleanharmaa);
        border-left: 3px solid var(--tummanvihrea);
        border-radius: 8px;
        background: rgba(52, 52, 52, 0.045);
        padding: 1rem 1.25rem;
        margin: 0 0 2rem;
        font-size: 0.9rem;
    }

    /* Layout.astro sets global p { margin: 0 } — restore readable paragraph rhythm in posts */
    .blogWrapper :global(p:not(.metadata)) {
        margin-bottom: 1.15rem;
    }

    /* must come after the p rhythm rule above: equal specificity, later wins */
    .blogWrapper .infoBasis p {
        margin-bottom: 0;
    }

    .blogWrapper .infoBasis .infoBasisReviewed {
        margin-top: 0.5rem;
        color: var(--harmaa);
        font-size: 0.85rem;
    }
    
    .blogWrapper :global(img) {
        border: 2px solid var(--vaaleanharmaa);
        border-radius: 8px;
        margin: var(--space-xl) 0;
        padding: 1rem;
        max-width: 100%;
        height: auto;
        display: block;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    
    .blogWrapper > :global(img:first-child) {
        margin-top: var(--space-2xl);
    }

    .blogWrapper :global(img.blogPhone),
    .blogWrapper :global(video.blogPhone) {
        display: block;
        width: 240px;
        max-width: 55%;
        margin: 1.25rem auto;
        padding: 0.45rem;
    }

    .blogWrapper :global(.blogPhoneRow) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 240px;
        gap: 1.25rem 2rem;
        align-items: start;
        margin: 1.25rem 0 1.75rem;
    }

    .blogWrapper :global(.blogPhoneRow .blogPhone) {
        width: 240px;
        max-width: 100%;
        margin: 0;
        justify-self: end;
    }

    .blogWrapper :global(.blogPhoneRow > :not(.blogPhone)) {
        min-width: 0;
    }

    .blogWrapper :global(.blogPhoneRow p:last-child) {
        margin-bottom: 0;
    }

    .blogWrapper :global(.blogPhonePair) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 240px));
        justify-content: center;
        gap: 1.25rem;
        margin: 1.25rem 0 1.75rem;
    }

    .blogWrapper :global(.blogPhonePair .blogPhone) {
        width: 100%;
        max-width: 240px;
        margin: 0;
    }

    .blogWrapper .blogHeroMedia :global(img.blogPhone) {
        width: 100%;
        max-width: 240px;
        margin: 0;
    }
    
    .blogWrapper :global(video) {
        border: 2px solid var(--vaaleanharmaa);
        border-radius: 8px;
        margin: var(--space-xl) 0;
        padding: 1rem;
        max-width: 100%;
        height: auto;
        display: block;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        background-color: #000;
    }

    .blogWrapper :global(table) {
        width: 100%;
        max-width: 42rem;
        margin: 1.25rem 0 1.5rem;
        border-collapse: collapse;
        border: 1px solid rgba(52, 52, 52, 0.12);
        border-radius: 6px;
        overflow: hidden;
        font-size: 0.95rem;
        line-height: 1.45;
    }

    /* overflow is ignored on display:table — switch to block so wide
       tables scroll sideways on mobile instead of breaking the layout */
    @media (max-width: 768px) {
        .blogWrapper :global(table) {
            display: block;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
    }

    @media (max-width: 700px) {
        .blogHero--phone {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-top: var(--space-base);
        }

        .blogHeroMedia :global(.tyov-screenshotFrame) {
            max-width: 200px;
        }

        .blogWrapper :global(img.blogPhone),
        .blogWrapper :global(video.blogPhone) {
            width: 200px;
            max-width: 55%;
            margin: 0.75rem auto 1.15rem;
        }

        .blogWrapper :global(.blogPhoneRow) {
            grid-template-columns: 1fr;
            justify-items: center;
            gap: 1rem;
        }

        .blogWrapper :global(.blogPhoneRow > :not(.blogPhone)) {
            justify-self: stretch;
        }

        .blogWrapper :global(.blogPhoneRow .blogPhone) {
            width: 200px;
            justify-self: center;
        }

        .blogWrapper :global(.blogPhonePair) {
            grid-template-columns: minmax(0, 200px);
        }
    }

    .blogWrapper :global(thead th) {
        background: rgba(52, 52, 52, 0.045);
        font-weight: 600;
    }

    .blogWrapper :global(th),
    .blogWrapper :global(td) {
        border: 1px solid rgba(52, 52, 52, 0.1);
        padding: 0.65rem 0.85rem;
        vertical-align: middle;
    }

    .postHubLinks {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 0.75rem;
        margin: 3rem 0 0;
        font-size: var(--text-sm);
    }

    .postHubLinks a {
        color: var(--tummanvihrea);
        font-weight: 600;
        text-decoration: none;
    }

    .postHubLinks a:hover {
        text-decoration: underline;
    }

    .postHubLinks span {
        color: var(--harmaa);
    }
</style>