# Cloudflare Turnstile (required for contact form)
# Create a widget at: https://dash.cloudflare.com/?to=/:account/turnstile
# Domains: tyovuorolista.fi, www.tyovuorolista.fi (add localhost for local testing)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AWS SES (production email sending)
AWS_SDK_ACCESS_KEY_ID=
AWS_SDK_SECRET_ACCESS_KEY=
AWS_SDK_REGION=
